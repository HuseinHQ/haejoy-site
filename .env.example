# Site fonts, applied at build time (restart `npm run dev` after changing).
# Options: nunito | fredoka | plus-jakarta-sans | outfit | manrope | inter
# Suggested pairs (display / body):
#   nunito / nunito          rounded, cozy (default)
#   fredoka / nunito         rounded, softer headings
#   plus-jakarta-sans / plus-jakarta-sans   modern, premium
#   outfit / inter           geometric, clean
#   manrope / manrope        neutral, minimal
FONT_DISPLAY=nunito
FONT_BODY=nunito
