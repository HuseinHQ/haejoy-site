---
import "../styles/global.css";
import SEO, { type Props as SEOProps } from "../components/SEO.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Sparkles from "../components/Sparkles.astro";
import dynapuff600 from "@fontsource/dynapuff/files/dynapuff-latin-600-normal.woff2?url";
import nunito400 from "@fontsource/nunito/files/nunito-latin-400-normal.woff2?url";

export type Props = SEOProps;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <link
      rel="preload"
      href={dynapuff600}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={nunito400}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <SEO {...Astro.props} />
    <script is:inline>
      // Runs before paint: apply the saved theme (no flash) and keep theme-color in sync with manual toggles.
      (() => {
        const root = document.documentElement;
        const colors = { light: "#f2f8ff", dark: "#0d1a2a" };
        const sync = () => {
          const t = root.dataset.theme;
          if (t)
            document
              .querySelectorAll('meta[name="theme-color"]')
              .forEach((m) => m.setAttribute("content", colors[t]));
        };
        try {
          const saved = localStorage.getItem("haejoy-theme");
          if (saved === "dark" || saved === "light") root.dataset.theme = saved;
        } catch (e) {}
        new MutationObserver(sync).observe(root, {
          attributes: true,
          attributeFilter: ["data-theme"],
        });
        sync();
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <Sparkles />
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
