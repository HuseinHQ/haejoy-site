<style>
  .scene {
    min-width: 0;
    justify-self: center;
    width: 100%;
    max-width: 400px;
    margin: 0;
  }
  .scene svg {
    width: 100%;
    height: auto;
    display: block;
  }
  .eye {
    transform-box: fill-box;
    transform-origin: center;
    animation: blink 5.5s infinite;
  }
  .steam {
    animation: steam 3.2s ease-in-out infinite;
    opacity: 0;
  }
  .steam.s2 {
    animation-delay: 1.2s;
  }
  @keyframes blink {
    0%,
    94%,
    100% {
      transform: scaleY(1);
    }
    96% {
      transform: scaleY(0.08);
    }
  }
  @keyframes steam {
    0% {
      transform: translateY(6px);
      opacity: 0;
    }
    40% {
      opacity: 0.8;
    }
    100% {
      transform: translateY(-10px);
      opacity: 0;
    }
  }
  @media (max-width: 820px) {
    .scene {
      order: -1;
      max-width: 300px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .eye,
    .steam {
      animation: none;
    }
    .steam {
      opacity: 0.5;
    }
  }
</style>
