---
import { site } from "../lib/site";

export interface Props {
  kitLink?: boolean; // link to /collab (off on the /collab page itself)
}
const { kitLink = true } = Astro.props;

const email = site.email || "collab@haejoy.my.id";
const mailto = `mailto:${email}?subject=${encodeURIComponent("Collab with Haejoy")}`;
const stats = (
  [
    ["subs", "subscribers"],
    ["views", "total views"],
    ["videos", "videos"],
  ] as const
).filter(([k]) => site.stats[k]);
const formats = [
  [
    "Cozy gameplay Shorts",
    "Your game, played in the channel's own style, so it never feels like an ad.",
  ],
  [
    "First impressions",
    "A first look at a new game in one short video, including beta or early access.",
  ],
  [
    "Events and creator codes",
    "Giveaways, creator codes, or event collabs for the community.",
  ],
];
---

<section class="band" id="collab">
  <div class="wrap collab">
    <div class="intro">
      <div class="sec-head">
        <span class="eyebrow">the collab desk</span>
        <h2>Want to work together?</h2>
        <p>
          For developers, publishers, and brands that fit a warm, laid-back
          channel.
        </p>
      </div>
      <ol class="formats">
        {formats.map(([title, text]) => (
          <li>
            <b>{title}</b>
            <span>{text}</span>
          </li>
        ))}
      </ol>
      {kitLink && (
        <a class="kit" href="/collab">
          See the media kit
        </a>
      )}
      {stats.length > 0 && (
        <div class="stats">
          {stats.map(([k, label]) => (
            <div class="stat">
              <b>{site.stats[k]}</b>
              <span>{label}</span>
            </div>
          ))}
        </div>
      )}
    </div>
    <div class="mail" data-mail>
      <h3>Send a message</h3>
      <p class="mail-note">
        Include your brand, the game, and what you have in mind. Replies usually
        take a few working days.
      </p>
      <div class="addr" data-addr>
        {email}
      </div>
      <div class="mail-row">
        <button class="btn small primary" type="button" data-copy>
          Copy email
        </button>
        <a class="mail-note" href={mailto}>
          Open in mail app
        </a>
        {!site.email && <span class="sample">placeholder email</span>}
      </div>
    </div>
  </div>
  <div class="toast" role="status" data-toast></div>
</section>

<style>
  .collab {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 36px;
    align-items: start;
  }
  .intro {
    display: grid;
    gap: 22px;
    min-width: 0;
  }
  .intro .sec-head {
    margin-bottom: 0;
  }
  .formats {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: fmt;
  }
  .formats li {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 14px;
    align-items: start;
    min-width: 0;
    counter-increment: fmt;
  }
  .formats li::before {
    content: counter(fmt);
    grid-row: span 2;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 2px solid var(--edge);
    display: grid;
    place-items: center;
    font-family: var(--f-display);
    font-weight: 700;
    background: var(--t-sky);
    font-size: 0.9rem;
  }
  .formats b {
    font-weight: 800;
  }
  .formats span {
    color: var(--ink2);
    font-size: 0.95rem;
  }
  .kit {
    font-weight: 800;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .mail {
    border: 2px solid var(--edge);
    border-radius: 22px;
    background: var(--surface);
    box-shadow: 4px 4px 0 var(--edge);
    padding: 24px;
    display: grid;
    gap: 14px;
    min-width: 0;
  }
  .addr {
    font-family: var(--f-display);
    font-weight: 600;
    font-size: 1.15rem;
    overflow-wrap: anywhere;
    background: var(--bg2);
    border-radius: 12px;
    padding: 12px 14px;
    user-select: all;
  }
  .mail-row {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }
  .mail-note {
    color: var(--ink2);
    font-size: 0.92rem;
  }
  .stats {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .stat {
    border: 2px solid var(--edge);
    border-radius: 14px;
    padding: 10px 16px;
    background: var(--t-sun);
  }
  .stat b {
    display: block;
    font-family: var(--f-display);
    font-size: 1.3rem;
    font-variant-numeric: tabular-nums;
  }
  .stat span {
    font-size: 0.82rem;
    color: var(--ink2);
  }
  @media (max-width: 860px) {
    .collab {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const box = document.querySelector<HTMLElement>("[data-mail]");
  const addr = box?.querySelector<HTMLElement>("[data-addr]");
  const toastEl = document.querySelector<HTMLElement>("[data-toast]");
  let timer: number | undefined;
  const toast = (msg: string) => {
    if (!toastEl) return;
    toastEl.textContent = msg;
    toastEl.classList.add("on");
    clearTimeout(timer);
    timer = window.setTimeout(() => toastEl.classList.remove("on"), 1800);
  };
  box?.querySelector("[data-copy]")?.addEventListener("click", async () => {
    if (!addr) return;
    try {
      await navigator.clipboard.writeText(addr.textContent?.trim() ?? "");
      toast("Email copied");
    } catch {
      const range = document.createRange();
      range.selectNodeContents(addr);
      const sel = getSelection();
      sel?.removeAllRanges();
      sel?.addRange(range);
      toast("Email selected, press copy");
    }
  });
</script>
