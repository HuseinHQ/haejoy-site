---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";

export interface Props {
  game: CollectionEntry<"games">;
  headingLevel?: 2 | 3;
}
const { game, headingLevel = 3 } = Astro.props;
const { id, data } = game;
const Heading = `h${headingLevel}` as const;
---

<article class:list={["game", `g-${data.tag}`]} data-tag={data.tag}>
  <Image
    class="cover"
    src={data.cover}
    alt={`${data.name} cover art`}
    widths={[240, 360, 480]}
    sizes="(max-width: 560px) 120px, 260px"
  />
  <div class="game-top">
    <Heading class="name">{data.name}</Heading>
    <small>{data.label}</small>
  </div>
  <div class="game-body">
    <p>{data.blurb}</p>
    <a href={`/games/${id}`}>
      {data.name} Shorts<span class="visually-hidden"> and notes</span>
    </a>
  </div>
</article>

<style>
  .game {
    border: 2px solid var(--edge);
    border-radius: 20px;
    background: var(--surface);
    box-shadow: 4px 4px 0 var(--edge);
    display: grid;
    grid-template-rows: auto auto 1fr;
    overflow: hidden;
    min-width: 0;
    transition: transform 0.18s;
  }
  .game:hover {
    transform: translateY(-4px) rotate(-0.6deg);
  }
  .cover {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    object-position: center 20%;
    border-bottom: 2px solid var(--edge);
    background: var(--bg2);
  }
  .game-top {
    padding: 12px 16px;
    border-bottom: 2px solid var(--edge);
  }
  .name {
    font-size: 1.2rem;
    overflow-wrap: anywhere;
  }
  small {
    display: block;
    font-family: var(--f-note);
    font-size: 0.8rem;
    color: var(--ink2);
  }
  .game-body {
    padding: 14px 16px 16px;
    display: grid;
    gap: 14px;
    align-content: space-between;
  }
  .game-body p {
    color: var(--ink2);
    font-size: 0.97rem;
  }
  .game-body a {
    font-weight: 800;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .g-cozy .game-top {
    background: var(--t-sun);
  }
  .g-open .game-top {
    background: var(--t-sky);
  }
  .g-social .game-top {
    background: var(--t-mint);
  }

  /* Phones: cover on the left, text on the right, so 8 cards don't become a very long scroll */
  @media (max-width: 560px) {
    .game {
      grid-template-columns: 112px 1fr;
      grid-template-rows: auto 1fr;
    }
    .cover {
      grid-row: 1 / span 2;
      height: 100%;
      min-height: 150px;
      aspect-ratio: auto;
      border-bottom: none;
      border-right: 2px solid var(--edge);
    }
    .game-body p {
      font-size: 0.92rem;
    }
  }
</style>
