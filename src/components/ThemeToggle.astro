---
// Label is switched by CSS from the current theme, so it is right on first paint without JS.
---

<button class="theme-btn" type="button" data-theme-toggle>
  <span class="to-night">Night mode</span>
  <span class="to-day">Day mode</span>
</button>

<style>
  .theme-btn {
    border: 2px solid var(--edge);
    background: var(--surface);
    border-radius: 999px;
    padding: 6px 14px;
    cursor: pointer;
    font-weight: 700;
    font-size: 0.9rem;
  }
  .to-day {
    display: none;
  }
  :global(:root[data-theme="dark"]) .to-day {
    display: inline;
  }
  :global(:root[data-theme="dark"]) .to-night {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .to-day {
      display: inline;
    }
    :global(:root:not([data-theme="light"])) .to-night {
      display: none;
    }
  }
  /* Theme ripple: drop the default cross-fade; the script animates a growing circle instead */
  :global(::view-transition-old(root)),
  :global(::view-transition-new(root)) {
    animation: none;
    mix-blend-mode: normal;
  }
</style>

<script>
  const root = document.documentElement;
  const isDark = () =>
    root.dataset.theme
      ? root.dataset.theme === "dark"
      : matchMedia("(prefers-color-scheme: dark)").matches;

  const btn = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");

  btn?.addEventListener("click", (e) => {
    const next = isDark() ? "light" : "dark";
    const apply = () => {
      root.dataset.theme = next;
      try {
        localStorage.setItem("haejoy-theme", next);
      } catch {}
    };

    // Ripple: the new theme grows as a circle from the click point until it covers the screen.
    // Unsupported browsers and reduced-motion users just switch instantly.
    if (
      !("startViewTransition" in document) ||
      matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
      return apply();
    }
    const box = (e.currentTarget as HTMLElement).getBoundingClientRect();
    // Keyboard "clicks" have no pointer position (detail === 0), so start from the button's centre.
    const x = e.detail ? e.clientX : box.left + box.width / 2;
    const y = e.detail ? e.clientY : box.top + box.height / 2;
    const radius = Math.hypot(
      Math.max(x, innerWidth - x),
      Math.max(y, innerHeight - y),
    );

    document.startViewTransition(apply).ready.then(() => {
      root.animate(
        {
          clipPath: [
            `circle(0px at ${x}px ${y}px)`,
            `circle(${radius}px at ${x}px ${y}px)`,
          ],
        },
        {
          duration: 600,
          easing: "cubic-bezier(0.4, 0, 0.2, 1)",
          pseudoElement: "::view-transition-new(root)",
        },
      );
    });
  });
</script>
