---
// Decorative drifting 4-point stars. Not rendered at all under prefers-reduced-motion.
---

<canvas class="sparks" aria-hidden="true" data-sparks></canvas>

<style>
  .sparks {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }
</style>

<script>
  const cv = document.querySelector<HTMLCanvasElement>("[data-sparks]");
  const ctx = cv?.getContext("2d");
  if (cv && ctx) {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) {
      cv.remove();
    } else {
      const root = document.documentElement;
      let cols = ["#FFC83A", "#5FB8E8"];
      const readColors = () => {
        const cs = getComputedStyle(root);
        cols = [
          cs.getPropertyValue("--spark1").trim() || cols[0]!,
          cs.getPropertyValue("--spark2").trim() || cols[1]!,
        ];
      };
      new MutationObserver(readColors).observe(root, {
        attributes: true,
        attributeFilter: ["data-theme"],
      });
      matchMedia("(prefers-color-scheme: dark)").addEventListener(
        "change",
        readColors,
      );
      readColors();

      let W = 0;
      let H = 0;
      const size = () => {
        W = cv.width = innerWidth;
        H = cv.height = innerHeight;
      };
      size();
      addEventListener("resize", size);

      const P = Array.from({ length: innerWidth < 600 ? 10 : 18 }, (_, i) => ({
        x: Math.random() * W,
        y: Math.random() * H,
        r: 3 + Math.random() * 4,
        v: 0.2 + Math.random() * 0.4,
        a: Math.random() * 6,
        w: 0.4 + Math.random() * 0.8,
        c: i % 2,
      }));
      const star = (r: number) => {
        ctx.beginPath();
        ctx.moveTo(0, -r * 1.6);
        ctx.quadraticCurveTo(0, 0, r * 1.6, 0);
        ctx.quadraticCurveTo(0, 0, 0, r * 1.6);
        ctx.quadraticCurveTo(0, 0, -r * 1.6, 0);
        ctx.quadraticCurveTo(0, 0, 0, -r * 1.6);
        ctx.fill();
      };
      const tick = () => {
        ctx.clearRect(0, 0, W, H);
        ctx.globalAlpha = 0.6;
        for (const p of P) {
          p.y += p.v;
          p.a += 0.01;
          p.x += Math.sin(p.a) * p.w * 0.5;
          if (p.y > H + 12) {
            p.y = -12;
            p.x = Math.random() * W;
          }
          ctx.save();
          ctx.translate(p.x, p.y);
          ctx.rotate(p.a * 0.5);
          ctx.fillStyle = cols[p.c]!;
          star(p.r);
          ctx.restore();
        }
        requestAnimationFrame(tick);
      };
      // Decoration only: start once the page has loaded so it never competes with first render.
      const start = () => setTimeout(tick, 600);
      if (document.readyState === "complete") start();
      else addEventListener("load", start, { once: true });
    }
  }
</script>
